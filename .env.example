# Weather API — https://openweathermap.org/api (free tier, sign up → API keys)
OPENWEATHER_API_KEY=

# Gemini AI — https://aistudio.google.com/app/apikey (free, instant)
GEMINI_API_KEY=

# Google Maps (optional, for place autocomplete & images)
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=

# IBM Cloudant (hackathon account — IBM Cloud dashboard → Resource list → Cloudant)
CLOUDANT_URL=
CLOUDANT_API_KEY=
CLOUDANT_DB_NAME=travel-plans
