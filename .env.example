# Weather API — https://openweathermap.org/api (free tier, sign up → API keys)
OPENWEATHER_API_KEY=

# IBM watsonx.ai — https://us-south.ml.cloud.ibm.com
# API key: IBM Cloud dashboard → Manage → Access (IAM) → API keys → Create
# Project ID: watsonx.ai → Projects → <your project> → Manage → General → Project ID
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# Google Places API — used to fetch hotel and restaurant images (optional)
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for AdvancedMarkerElement (leave blank to use Google's built-in "DEMO_MAP_ID" for testing)
# Create one at: console.cloud.google.com → Google Maps Platform → Map Management
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Unsplash — used to fetch attraction images (optional)
# https://unsplash.com/developers → Your applications → Access Key
UNSPLASH_ACCESS_KEY=

# IBM Cloudant (hackathon account — IBM Cloud dashboard → Resource list → Cloudant)
CLOUDANT_URL=
CLOUDANT_API_KEY=
CLOUDANT_DB_NAME=
